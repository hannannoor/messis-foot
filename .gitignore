# Repository root: only the submission files and development/ are tracked.
# Match data (provided or external) and anything derived from it must never be committed.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/technical-document.md
!/technical-document.pdf
!/requirements.txt
!/strong_release.py
!/strong_model/
!/development/
*.csv
*.xml
*.npy
*.parquet
*.mp4
__pycache__/
*.py[cod]
